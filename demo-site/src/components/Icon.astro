const icon = icons[name] ?? { body: '' };
const viewBox = icon.viewBox ?? '0 0 24 24';
const strokeProps = icon.fill
  ? { fill: 'currentColor' }
  : {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': sw,
      'stroke-linecap': 'round',
      'stroke-linejoin': 'round',
    };
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox={viewBox}
  aria-hidden="true"
  focusable="false"
  {...strokeProps}
  set:html={icon.body}
/>

---
import Icon from './Icon.astro';

/**
 * CI/CD pipeline flow — a bespoke, theme-aware diagram that renders as a
 * semantic ordered list (read in order by screen readers) and a horizontal
 * flow visually. No external dependencies.
 */
const stages = [
  { name: 'Code Push', icon: 'git-branch', role: 'source' },
  { name: 'CI Validation', icon: 'list-checks', role: 'ci' },
  { name: 'Build & Push', icon: 'layers', role: 'ci' },
  { name: 'Deploy Dev', icon: 'rocket', role: 'deploy', gate: { label: 'Automatic', tone: 'auto' } },
  { name: 'Deploy Staging', icon: 'cloud', role: 'deploy', gate: { label: 'Approval', tone: 'gate' } },
  { name: 'Deploy Prod', icon: 'shield-check', role: 'deploy', gate: { label: 'Approval', tone: 'gate' } },
];
---

<figure class="pipeline">
  <ol class="pipeline__flow">
    {
      stages.map((s) => (
        <li class="pipeline__stage" data-role={s.role}>
          <span class="pipeline__icon">
            <Icon name={s.icon} size={18} />
          </span>
          <span class="pipeline__name">{s.name}</span>
          {s.gate ? (
            <span class="pipeline__gate" data-tone={s.gate.tone}>
              {s.gate.label}
            </span>
          ) : (
            <span class="pipeline__gate pipeline__gate--ghost">Continuous</span>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="pipeline__caption">
    Dev deploys automatically on merge; staging and production each require a manual approval gate.
  </figcaption>
</figure>

<style>
  .pipeline {
    margin: 1.6rem 0;
    padding: 1.5rem 1.4rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-inset);
  }

  .pipeline__flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    gap: 1.9rem;
  }

  .pipeline__stage {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 0.6rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  /* connector chevron sitting in the gap between stages */
  .pipeline__stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -1.28rem;
    width: 0.62rem;
    height: 0.62rem;
    border-top: 2px solid var(--border-strong);
    border-right: 2px solid var(--border-strong);
    transform: translateY(-50%) rotate(45deg);
  }

  .pipeline__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    color: var(--text-muted);
    background: var(--surface-3);
    border: 1px solid var(--border);
  }
  .pipeline__stage[data-role='ci'] .pipeline__icon {
    color: var(--accent-fg);
    background: var(--accent-wash);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  .pipeline__stage[data-role='deploy'] .pipeline__icon {
    color: var(--purple);
    background: var(--purple-wash);
    border-color: color-mix(in oklab, var(--purple) 30%, transparent);
  }

  .pipeline__name {
    font-weight: 580;
    font-size: 0.9rem;
    color: var(--ink);
    line-height: 1.2;
  }

  .pipeline__gate {
    font-size: 0.68rem;
    font-weight: 560;
    letter-spacing: 0.02em;
    padding: 0.16rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .pipeline__gate[data-tone='auto'] {
    color: var(--accent-fg);
    background: var(--accent-wash);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
  }
  .pipeline__gate[data-tone='gate'] {
    color: var(--warn);
    background: var(--warn-wash);
    border-color: color-mix(in oklab, var(--warn) 32%, transparent);
  }
  .pipeline__gate--ghost {
    color: var(--text-subtle);
    background: transparent;
    border-color: var(--border-muted);
  }

  .pipeline__caption {
    margin-top: 1.1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-align: center;
  }

  /* Stack vertically on narrow viewports; connector points downward. */
  @media (max-width: 46rem) {
    .pipeline__flow {
      flex-direction: column;
      gap: 1.6rem;
    }
    .pipeline__stage {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.85rem;
      text-align: left;
      padding: 0.75rem 0.9rem;
    }
    .pipeline__name {
      flex: 1;
    }
    .pipeline__stage:not(:last-child)::after {
      top: auto;
      bottom: -1.1rem;
      right: auto;
      left: 1.55rem;
      transform: translateX(-50%) rotate(135deg);
    }
  }
</style>

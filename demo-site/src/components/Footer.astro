---
import Icon from './Icon.astro';
import { SITE, TOP_NAV, href } from '../lib/site';

const year = new Date().getFullYear();

const resourceLinks = [
  { label: 'GitHub Copilot', url: SITE.copilot, icon: 'sparkles' },
  { label: 'Repository', url: SITE.repo, icon: 'github' },
  { label: 'Open in Codespaces', url: SITE.codespaces, icon: 'rocket' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="brand" href={href('/')} aria-label={`${SITE.shortTitle} — home`}>
        <span class="brand__mark"><Icon name="sparkles" size={19} /></span>
        <span class="brand__name">{SITE.shortTitle}</span>
      </a>
      <p>{SITE.description}</p>
    </div>

    <nav class="site-footer__col" aria-label="Guide">
      <h2>Guide</h2>
      {TOP_NAV.map((item) => <a href={href(item.slug)}>{item.label}</a>)}
    </nav>

    <nav class="site-footer__col" aria-label="Resources">
      <h2>Resources</h2>
      {
        resourceLinks.map((l) => (
          <a href={l.url} target="_blank" rel="noreferrer noopener">
            <Icon name={l.icon} size={15} />
            <span>{l.label}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>© {year} Octo E-Shop demo. A GitHub Copilot showcase — built for presenting, not for production.</p>
    <p class="site-footer__stack">Astro · Mona&nbsp;Sans · JetBrains&nbsp;Mono</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border-muted);
    background: var(--bg-inset);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }
  .site-footer__brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
  .site-footer__brand .brand__mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-sm);
    color: #fff;
    background: var(--grad-copilot);
  }
  .site-footer__brand .brand__name {
    font-family: var(--font-display);
    font-weight: 680;
    font-size: 1.05rem;
  }
  .site-footer__brand p {
    margin-top: 0.9rem;
    max-width: 34ch;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .site-footer__col h2 {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .site-footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    width: fit-content;
  }
  .site-footer__col a:hover {
    color: var(--link-hover);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.4rem 2.2rem;
    border-top: 1px solid var(--border-muted);
    color: var(--text-subtle);
    font-size: 0.84rem;
  }
  .site-footer__stack {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
